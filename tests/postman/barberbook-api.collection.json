                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\u0027El registro responde con HTTP 201\u0027, function () {",
                                                                   "    pm.response.to.have.status(201);",
                                                                   "});",
                                                                   "pm.test(\u0027El registro confirma el éxito\u0027, function () {",
                                                                   "    pm.expect(pm.response.json().success).to.eql(true);",
                                                                   "});",
                                                                   "pm.test(\u0027La respuesta incluye el usuario sin exponer la contraseña\u0027, function () {",
                                                                   "    const user = pm.response.json().user;",
                                                                   "    pm.expect(user).to.have.property(\u0027email\u0027);",
                                                                   "    pm.expect(user).not.to.have.property(\u0027password\u0027);",
                                                                   "});"
                                                               ],
